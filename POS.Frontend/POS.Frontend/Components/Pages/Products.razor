@page "/products"
@implements IDisposable

<PageTitle>Products</PageTitle>

<div class="product-page">
    <header class="page-heading">
        <div>
            <h1>Products</h1>
            <p>Search the catalog and monitor current inventory.</p>
        </div>
        <a class="primary-action" href="/products/new">
            <span aria-hidden="true">+</span>
            Add product
        </a>
    </header>

    <section class="filter-card">
        <form class="search-form" @onsubmit="ApplySearchAsync" @onsubmit:preventDefault="true">
            <label for="product-search">Search</label>
            <div class="search-control">
                <input id="product-search"
                       type="search"
                       placeholder="Search by name or code"
                       maxlength="100"
                       disabled="@isLoading"
                       value="@param.Search"
                       @oninput="SearchChangedAsync" />
                <button type="submit" class="primary-action" disabled="@isLoading">Search</button>
            </div>
        </form>

        <div class="filter-control">
            <label for="category-filter">Category</label>
            <select id="category-filter"
                    disabled="@isLoading"
                    @bind="param.CategoryId"
                    @bind:after="FiltersChangedAsync">
                <option value="">All categories</option>
                @foreach (var category in categories)
                {
                    <option value="@category.Id">@category.Name</option>
                }
            </select>
        </div>

        <div class="filter-control">
            <label for="sort-field">Sort by</label>
            <div class="sort-control">
                <select id="sort-field"
                        disabled="@isLoading"
                        @bind="param.SortBy"
                        @bind:after="FiltersChangedAsync">
                    <option value="name">Name</option>
                    <option value="code">Code</option>
                    <option value="category">Category</option>
                    <option value="price">Price</option>
                    <option value="stockQuantity">Stock</option>
                    <option value="reorderLevel">Reorder level</option>
                </select>
                <button type="button"
                        class="sort-direction"
                        disabled="@isLoading"
                        title="@(param.SortDescending ? "Descending" : "Ascending")"
                        @onclick="ToggleSortDirectionAsync">
                    @(param.SortDescending ? "↓" : "↑")
                </button>
            </div>
        </div>

        <label class="checkbox-control">
            <input type="checkbox"
                   disabled="@isLoading"
                   @bind="param.LowStockOnly"
                   @bind:after="FiltersChangedAsync" />
            <span>Low stock only</span>
        </label>

        <button type="button" class="reset-button" disabled="@isLoading" @onclick="ResetFiltersAsync">
            Reset
        </button>
    </section>

    @if (isLoading)
    {
        <section class="state-card" role="status" aria-live="polite">
            <span class="loading-spinner" aria-hidden="true"></span>
            <span>Loading products...</span>
        </section>
    }
    else if (errorMessage is not null)
    {
        <div class="alert-message error" role="alert">
            <span>@errorMessage</span>
            <button type="button" class="text-button" @onclick="LoadProductsAsync">Try again</button>
        </div>
    }
    else if (productsPage.Items.Count == 0)
    {
        <section class="empty-card">
            <span class="empty-icon" aria-hidden="true">◇</span>
            <h2>@(HasActiveFilters ? "No matching products" : "No products yet")</h2>
            <p>
                @(HasActiveFilters
                    ? "Try changing or resetting the current filters."
                    : "Products will appear here after they are added.")
            </p>
            @if (HasActiveFilters)
            {
                <button type="button" class="secondary-action" @onclick="ResetFiltersAsync">Reset filters</button>
            }
        </section>
    }
    else
    {
        <section class="list-card">
            <div class="list-card-heading">
                <div>
                    <h2>Inventory</h2>
                    <span>Showing @FirstItemNumber–@LastItemNumber of @productsPage.TotalCount</span>
                </div>

                <div class="page-size-control">
                    <label for="page-size">Rows</label>
                    <select id="page-size"
                            disabled="@isLoading"
                            @bind="param.PageSize"
                            @bind:after="PageSizeChangedAsync">
                        <option value="5">5</option>
                        <option value="10">10</option>
                        <option value="20">20</option>
                        <option value="50">50</option>
                    </select>
                </div>
            </div>

            <div class="table-wrapper">
                <table class="product-table">
                    <thead>
                        <tr>
                            <th scope="col">Product</th>
                            <th scope="col">Category</th>
                            <th scope="col" class="number-column">Price</th>
                            <th scope="col" class="number-column">Stock</th>
                            <th scope="col" class="number-column">Reorder level</th>
                            <th scope="col">Status</th>
                            <th scope="col" class="actions-column">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var product in productsPage.Items)
                        {
                            <tr @key="product.Id">
                                <td data-label="Product">
                                    <strong>@product.Name</strong>
                                    <span class="product-code">@product.Code</span>
                                </td>
                                <td data-label="Category">@(product.CategoryName ?? "Uncategorized")</td>
                                <td data-label="Price" class="number-column">@product.Price.ToString("N2")</td>
                                <td data-label="Stock" class="number-column">@product.StockQuantity</td>
                                <td data-label="Reorder level" class="number-column">@product.ReorderLevel</td>
                                <td data-label="Status">
                                    @if (product.IsLowStock)
                                    {
                                        <span class="low-stock-badge">Low stock</span>
                                    }
                                    else
                                    {
                                        <span class="in-stock-text">In stock</span>
                                    }
                                </td>
                                <td data-label="Actions" class="row-actions">
                                    <a class="text-button" href="@($"/products/edit/{product.Id}")">Edit</a>
                                    <button type="button"
                                            class="text-button danger"
                                            disabled="@isDeleting"
                                            @onclick="() => ConfirmDelete(product)">
                                        Delete
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <footer class="pagination">
                <button type="button"
                        class="page-button"
                        disabled="@(isLoading || productsPage.Page <= 1)"
                        @onclick="PreviousPageAsync">
                    Previous
                </button>
                <span>Page @productsPage.Page of @productsPage.TotalPages</span>
                <button type="button"
                        class="page-button"
                        disabled="@(isLoading || productsPage.Page >= productsPage.TotalPages)"
                        @onclick="NextPageAsync">
                    Next
                </button>
            </footer>
        </section>
    }
</div>

@if (productPendingDelete is not null)
{
    <div class="dialog-backdrop" role="presentation" @onclick="CancelDelete">
        <section class="confirm-dialog"
                 role="dialog"
                 aria-modal="true"
                 @onclick:stopPropagation="true">
            <div class="dialog-heading">
                <h2>Delete product?</h2>
                <button type="button"
                        class="close-button"
                        title="Close"
                        disabled="@isDeleting"
                        @onclick="CancelDelete">
                    ×
                </button>
            </div>

            <p>Delete <strong>@productPendingDelete.Name</strong>?</p>
            <p class="dialog-note">A product used in a sale cannot be deleted.</p>

            @if (deleteErrorMessage is not null)
            {
                <div class="alert-message error dialog-error" role="alert">@deleteErrorMessage</div>
            }

            <div class="dialog-actions">
                <button type="button" class="secondary-action" disabled="@isDeleting" @onclick="CancelDelete">
                    Cancel
                </button>
                <button type="button" class="danger-action" disabled="@isDeleting" @onclick="DeleteProductAsync">
                    @(isDeleting ? "Deleting..." : "Delete")
                </button>
            </div>
        </section>
    </div>
}

@code {
    private readonly CancellationTokenSource cancellationTokenSource = new();
    private readonly ProductParamModel param = new();
    private CancellationTokenSource? searchCancellationTokenSource;
    private PagedResult<ProductModel> productsPage = new();
    private List<CategoryModel> categories = [];
    private ProductModel? productPendingDelete;
    private string? errorMessage;
    private string? deleteErrorMessage;
    private bool isLoading = true;
    private bool isDeleting;

    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(param.Search) ||
        param.CategoryId.HasValue ||
        param.LowStockOnly;

    private int FirstItemNumber => productsPage.TotalCount == 0
        ? 0
        : ((productsPage.Page - 1) * productsPage.PageSize) + 1;

    private int LastItemNumber => Math.Min(
        productsPage.Page * productsPage.PageSize,
        productsPage.TotalCount);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadInitialDataAsync();
            StateHasChanged();
        }
    }

    private async Task LoadInitialDataAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var categoriesTask = CategoriesClient.GetCategoriesAsync(cancellationTokenSource.Token);
            var productsTask = ProductsClient.GetProductsPagingAsync(param, cancellationTokenSource.Token);

            await Task.WhenAll(categoriesTask, productsTask);

            var categoriesResult = await categoriesTask;
            var productsResult = await productsTask;

            if (!categoriesResult.IsSuccess)
            {
                errorMessage = categoriesResult.Message;
                return;
            }

            if (!productsResult.IsSuccess)
            {
                errorMessage = productsResult.Message;
                return;
            }

            categories = categoriesResult.Data ?? [];
            productsPage = productsResult.Data ?? new();
        }
        catch (ApiException exception)
        {
            errorMessage = exception.Message;
        }
        catch (OperationCanceledException) when (cancellationTokenSource.IsCancellationRequested)
        {
        }
        finally
        {
            isLoading = false;
        }
    }

    private Task LoadProductsAsync() =>
        LoadProductsAsync(cancellationTokenSource.Token);

    private async Task LoadProductsAsync(CancellationToken cancellationToken)
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var result = await ProductsClient.GetProductsPagingAsync(
                param,
                cancellationToken);

            if (!result.IsSuccess)
            {
                errorMessage = result.Message;
                return;
            }

            productsPage = result.Data ?? new();
        }
        catch (ApiException exception)
        {
            errorMessage = exception.Message;
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ApplySearchAsync()
    {
        CancelDebouncedSearch();
        param.Page = 1;
        await LoadProductsAsync();
    }

    private async Task SearchChangedAsync(ChangeEventArgs eventArgs)
    {
        param.Search = eventArgs.Value?.ToString();
        CancelDebouncedSearch();

        searchCancellationTokenSource = CancellationTokenSource.CreateLinkedTokenSource(
            cancellationTokenSource.Token);
        var cancellationToken = searchCancellationTokenSource.Token;

        try
        {
            // If the token is not cancelled, wait 400 ms and then continue to the next line.
            // If the token is cancelled during those 400 ms, immediately stop waiting and throw OperationCanceledException.
            await Task.Delay(400, cancellationToken);
            param.Page = 1;
            await LoadProductsAsync(cancellationToken);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
    }

    private async Task FiltersChangedAsync()
    {
        param.Page = 1;
        await LoadProductsAsync();
    }

    private async Task ToggleSortDirectionAsync()
    {
        param.SortDescending = !param.SortDescending;
        param.Page = 1;
        await LoadProductsAsync();
    }

    private async Task PageSizeChangedAsync()
    {
        param.Page = 1;
        await LoadProductsAsync();
    }

    private async Task ResetFiltersAsync()
    {
        CancelDebouncedSearch();
        param.Search = null;
        param.CategoryId = null;
        param.LowStockOnly = false;
        param.SortBy = "name";
        param.SortDescending = false;
        param.Page = 1;
        await LoadProductsAsync();
    }

    private void ConfirmDelete(ProductModel product)
    {
        productPendingDelete = product;
        deleteErrorMessage = null;
    }

    private void CancelDelete()
    {
        if (!isDeleting)
        {
            productPendingDelete = null;
            deleteErrorMessage = null;
        }
    }

    private async Task DeleteProductAsync()
    {
        if (productPendingDelete is null)
        {
            return;
        }

        isDeleting = true;
        deleteErrorMessage = null;

        try
        {
            var result = await ProductsClient.DeleteProductAsync(
                productPendingDelete.Id,
                cancellationTokenSource.Token);

            if (!result.IsSuccess)
            {
                deleteErrorMessage = result.Message;
                return;
            }

            if (productsPage.Items.Count == 1 && param.Page > 1)
            {
                param.Page--;
            }

            productPendingDelete = null;
            await LoadProductsAsync();
        }
        catch (ApiException exception)
        {
            deleteErrorMessage = exception.Message;
        }
        catch (OperationCanceledException) when (cancellationTokenSource.IsCancellationRequested)
        {
        }
        finally
        {
            isDeleting = false;
        }
    }

    private async Task PreviousPageAsync()
    {
        if (param.Page <= 1)
        {
            return;
        }

        param.Page--;
        await LoadProductsAsync();
    }

    private async Task NextPageAsync()
    {
        if (param.Page >= productsPage.TotalPages)
        {
            return;
        }

        param.Page++;
        await LoadProductsAsync();
    }

    private void CancelDebouncedSearch()
    {
        searchCancellationTokenSource?.Cancel();
        searchCancellationTokenSource?.Dispose();
        searchCancellationTokenSource = null;
    }

    public void Dispose()
    {
        CancelDebouncedSearch();
        cancellationTokenSource.Cancel();
        cancellationTokenSource.Dispose();
    }
}
