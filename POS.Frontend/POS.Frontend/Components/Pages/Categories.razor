@page "/categories"
@implements IDisposable

<PageTitle>Categories</PageTitle>

<div class="category-page">
    <header class="page-heading">
        <div>
            <h1>Categories</h1>
            <p>Organize the product catalog.</p>
        </div>
        <a class="primary-action" href="/categories/new">
            <span aria-hidden="true">+</span>
            Add category
        </a>
    </header>

    @if (isLoading)
    {
        <section class="state-card" role="status" aria-live="polite">
            <span class="loading-spinner" aria-hidden="true"></span>
            <span>Loading categories...</span>
        </section>
    }
    else if (errorMessage is not null)
    {
        <div class="alert-message error" role="alert">
            <span>@errorMessage</span>
            <button type="button" class="text-button danger" @onclick="LoadCategoriesAsync">Try again</button>
        </div>
    }
    else if (categories is null || categories.Count == 0)
    {
        <section class="empty-card">
            <span class="empty-icon" aria-hidden="true">◇</span>
            <h2>No categories yet</h2>
            <p>Add the first category to start organizing products.</p>
            <a class="primary-action" href="/categories/new">Create category</a>
        </section>
    }
    else
    {
        @if (deleteErrorMessage is not null)
        {
            <div class="alert-message error" role="alert">@deleteErrorMessage</div>
        }

        <section class="list-card">
            <div class="list-card-heading">
                <h2>All categories</h2>
                <span>@categories.Count @(categories.Count == 1 ? "category" : "categories")</span>
            </div>

            <div class="table-wrapper">
                <table class="category-table">
                    <thead>
                        <tr>
                            <th scope="col">Name</th>
                            <th scope="col" class="actions-column">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var category in categories)
                        {
                            <tr @key="category.Id">
                                <td data-label="Name"><strong>@category.Name</strong></td>
                                <td data-label="Actions" class="row-actions">
                                    <a class="text-button" href="@($"/categories/edit/{category.Id}")">Edit</a>
                                    <button type="button"
                                            class="text-button danger"
                                            disabled="@isDeleting"
                                            @onclick="() => ConfirmDelete(category)">
                                        Delete
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
</div>

@if (categoryPendingDelete is not null)
{
    <div class="dialog-backdrop" role="presentation" @onclick="CancelDelete">
        <section class="confirm-dialog"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="delete-dialog-title"
                 @onclick:stopPropagation="true">
            <div class="dialog-heading">
                <h2 id="delete-dialog-title">Delete category?</h2>
                <button type="button"
                        class="close-button"
                        aria-label="Close"
                        disabled="@isDeleting"
                        @onclick="CancelDelete">
                    ×
                </button>
            </div>

            <p>Delete <strong>@categoryPendingDelete.Name</strong>?</p>
            <p class="dialog-note">A category used by products cannot be deleted.</p>

            @if (deleteErrorMessage is not null)
            {
                <div class="alert-message error" role="alert">@deleteErrorMessage</div>
            }

            <div class="dialog-actions">
                <button type="button" class="secondary-action" disabled="@isDeleting" @onclick="CancelDelete">
                    Cancel
                </button>
                <button type="button" class="danger-action" disabled="@isDeleting" @onclick="DeleteCategoryAsync">
                    @(isDeleting ? "Deleting..." : "Delete")
                </button>
            </div>
        </section>
    </div>
}

@code {
    private readonly CancellationTokenSource cancellationTokenSource = new();
    private List<CategoryModel>? categories;
    private CategoryModel? categoryPendingDelete;
    private string? errorMessage;
    private string? deleteErrorMessage;
    private bool isLoading = true;
    private bool isDeleting;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadCategoriesAsync();
            StateHasChanged();
        }
    }

    private async Task LoadCategoriesAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var result = await CategoriesClient.GetCategoriesAsync(cancellationTokenSource.Token);

            if (!result.IsSuccess)
            {
                errorMessage = result.Message;
                return;
            }

            categories = result.Data ?? [];
        }
        catch (ApiException exception)
        {
            errorMessage = exception.Message;
        }
        catch (OperationCanceledException) when (cancellationTokenSource.IsCancellationRequested)
        {
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ConfirmDelete(CategoryModel category)
    {
        categoryPendingDelete = category;
        deleteErrorMessage = null;
    }

    private void CancelDelete()
    {
        if (!isDeleting)
        {
            categoryPendingDelete = null;
            deleteErrorMessage = null;
        }
    }

    private async Task DeleteCategoryAsync()
    {
        if (categoryPendingDelete is null)
        {
            return;
        }

        isDeleting = true;
        deleteErrorMessage = null;

        try
        {
            var result = await CategoriesClient.DeleteCategoryAsync(
                categoryPendingDelete.Id,
                cancellationTokenSource.Token);

            if (!result.IsSuccess)
            {
                deleteErrorMessage = result.Message;
                return;
            }

            if (result.Data is not null)
            {
                categories?.RemoveAll(category => category.Id == result.Data.Id);
            }

            categoryPendingDelete = null;
        }
        catch (ApiException exception)
        {
            deleteErrorMessage = exception.Message;
        }
        catch (OperationCanceledException) when (cancellationTokenSource.IsCancellationRequested)
        {
        }
        finally
        {
            isDeleting = false;
        }
    }

    public void Dispose()
    {
        cancellationTokenSource.Cancel();
        cancellationTokenSource.Dispose();
    }
}
