@page "/categories"
@rendermode InteractiveServer
@implements IDisposable
@inject CategoriesClient CategoriesClient

<PageTitle>Categories</PageTitle>

<div class="d-flex align-items-start justify-content-between gap-3 mb-4">
    <div>
        <h1>Categories</h1>
        <p class="text-muted mb-0">Organize products into categories.</p>
    </div>
    <a class="btn btn-primary" href="categories/new">Add category</a>
</div>

@if (isLoading)
{
    <div class="d-flex align-items-center gap-2" role="status" aria-live="polite">
        <div class="spinner-border spinner-border-sm" aria-hidden="true"></div>
        <span>Loading categories...</span>
    </div>
}
else if (errorMessage is not null)
{
    <div class="alert alert-danger" role="alert">
        <p class="mb-2">@errorMessage</p>
        <button class="btn btn-sm btn-outline-danger" @onclick="LoadCategoriesAsync">Try again</button>
    </div>
}
else if (categories is null || categories.Count == 0)
{
    <div class="border rounded p-4 text-center bg-body-tertiary">
        <h2 class="h5">No categories yet</h2>
        <p class="text-muted">Create the first category to start organizing products.</p>
        <a class="btn btn-primary" href="categories/new">Create category</a>
    </div>
}
else
{
    <div class="table-responsive border rounded">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th scope="col">Name</th>
                    <th scope="col" class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var category in categories)
                {
                    <tr @key="category.Id">
                        <td>@category.Name</td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-secondary me-2"
                               href="@($"categories/edit/{category.Id}")">Edit</a>
                            <button class="btn btn-sm btn-outline-danger"
                                    @onclick="() => ConfirmDelete(category)">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (categoryPendingDelete is not null)
{
    <div class="modal d-block" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="delete-category-title">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="delete-category-title">Delete category?</h2>
                    <button type="button" class="btn-close" aria-label="Close"
                            disabled="@isDeleting" @onclick="CancelDelete"></button>
                </div>
                <div class="modal-body">
                    <p>Delete <strong>@categoryPendingDelete.Name</strong>?</p>
                    <p class="text-muted mb-0">A category used by products cannot be deleted.</p>

                    @if (deleteErrorMessage is not null)
                    {
                        <div class="alert alert-danger mt-3 mb-0" role="alert">@deleteErrorMessage</div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary"
                            disabled="@isDeleting" @onclick="CancelDelete">Cancel</button>
                    <button type="button" class="btn btn-danger"
                            disabled="@isDeleting" @onclick="DeleteCategoryAsync">
                        @(isDeleting ? "Deleting..." : "Delete")
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop show"></div>
}

@code {
    private readonly CancellationTokenSource cancellationTokenSource = new();
    private List<CategoryModel>? categories;
    private CategoryModel? categoryPendingDelete;
    private string? errorMessage;
    private string? deleteErrorMessage;
    private bool isLoading = true;
    private bool isDeleting;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadCategoriesAsync();
            StateHasChanged();
        }
    }

    private async Task LoadCategoriesAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var result = await CategoriesClient.GetCategoriesAsync(cancellationTokenSource.Token);

            if (!result.IsSuccess)
            {
                errorMessage = result.Message;
                return;
            }

            categories = result.Data ?? [];
        }
        catch (ApiException exception)
        {
            errorMessage = exception.Message;
        }
        catch (OperationCanceledException) when (cancellationTokenSource.IsCancellationRequested)
        {
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ConfirmDelete(CategoryModel category)
    {
        categoryPendingDelete = category;
        deleteErrorMessage = null;
    }

    private void CancelDelete()
    {
        if (!isDeleting)
        {
            categoryPendingDelete = null;
            deleteErrorMessage = null;
        }
    }

    private async Task DeleteCategoryAsync()
    {
        if (categoryPendingDelete is null)
        {
            return;
        }

        isDeleting = true;
        deleteErrorMessage = null;

        try
        {
            var result = await CategoriesClient.DeleteCategoryAsync(
                categoryPendingDelete.Id,
                cancellationTokenSource.Token);

            if (!result.IsSuccess)
            {
                deleteErrorMessage = result.Message;
                return;
            }

            if (result.Data is not null)
            {
                categories?.RemoveAll(category => category.Id == result.Data.Id);
            }

            categoryPendingDelete = null;
        }
        catch (ApiException exception)
        {
            deleteErrorMessage = exception.Message;
        }
        catch (OperationCanceledException) when (cancellationTokenSource.IsCancellationRequested)
        {
        }
        finally
        {
            isDeleting = false;
        }
    }

    public void Dispose()
    {
        cancellationTokenSource.Cancel();
        cancellationTokenSource.Dispose();
    }
}
