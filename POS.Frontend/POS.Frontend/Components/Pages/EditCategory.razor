@page "/categories/new"
@page "/categories/edit/{Id:int}"
@rendermode InteractiveServer
@implements IDisposable
@inject CategoriesClient CategoriesClient
@inject NavigationManager Navigation

<PageTitle>@(Id.HasValue ? "Edit category" : "New category")</PageTitle>

<div class="category-form-page">
    <a class="back-link" href="/categories">
        <span aria-hidden="true">←</span>
        Back to categories
    </a>

    <header class="page-heading">
        <h1>@(Id.HasValue ? "Edit category" : "New category")</h1>
        <p>@(Id.HasValue ? "Update the category name below." : "Create a category for grouping products.")</p>
    </header>

    @if (isLoading)
    {
        <section class="state-card" role="status" aria-live="polite">
            <span class="loading-spinner" aria-hidden="true"></span>
            <span>Loading category...</span>
        </section>
    }
    else
    {
        @if (errorMessage is not null)
        {
            <div class="alert-message error" role="alert">@errorMessage</div>
        }

        <section class="form-card">
            <EditForm Model="model" OnValidSubmit="SaveAsync" FormName="category-form" class="category-form">
                <DataAnnotationsValidator />

                <div class="form-introduction">
                    <h2>Category details</h2>
                    <p>The category name can contain up to 50 characters.</p>
                </div>

                <div class="form-field">
                    <label for="category-name">Category name</label>
                    <InputText id="category-name"
                               class="form-input"
                               autocomplete="off"
                               placeholder="For example, Beverages"
                               disabled="@isSaving"
                               @bind-Value="model.Name" />
                    <ValidationMessage For="@(() => model.Name)" class="field-error" />
                </div>

                <div class="form-actions">
                    <a class="secondary-action" href="/categories">Cancel</a>
                    <button type="submit" class="primary-action" disabled="@isSaving">
                        @(isSaving ? "Saving..." : "Save category")
                    </button>
                </div>
            </EditForm>
        </section>
    }
</div>

@code {
    private readonly CancellationTokenSource cancellationTokenSource = new();
    private CategoryFormModel model = new();
    private string? errorMessage;
    private bool isLoading;
    private bool isSaving;

    [Parameter]
    public int? Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        model = new CategoryFormModel();
        errorMessage = null;

        if (!Id.HasValue)
        {
            isLoading = false;
            return;
        }

        isLoading = true;

        try
        {
            var result = await CategoriesClient.GetCategoryAsync(
                Id.Value,
                cancellationTokenSource.Token);

            if (!result.IsSuccess)
            {
                errorMessage = result.Message;
                return;
            }

            if (result.Data is null)
            {
                errorMessage = "The API returned the category without data.";
                return;
            }

            model.Name = result.Data.Name;
        }
        catch (ApiException exception)
        {
            errorMessage = exception.Message;
        }
        catch (OperationCanceledException) when (cancellationTokenSource.IsCancellationRequested)
        {
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SaveAsync()
    {
        isSaving = true;
        errorMessage = null;

        try
        {
            if (Id.HasValue)
            {
                var result = await CategoriesClient.UpdateCategoryAsync(
                    Id.Value,
                    model,
                    cancellationTokenSource.Token);

                if (!result.IsSuccess)
                {
                    errorMessage = result.Message;
                    return;
                }
            }
            else
            {
                var result = await CategoriesClient.CreateCategoryAsync(
                    model,
                    cancellationTokenSource.Token);

                if (!result.IsSuccess)
                {
                    errorMessage = result.Message;
                    return;
                }
            }

            Navigation.NavigateTo("categories");
        }
        catch (ApiException exception)
        {
            errorMessage = exception.Message;
        }
        catch (OperationCanceledException) when (cancellationTokenSource.IsCancellationRequested)
        {
        }
        finally
        {
            isSaving = false;
        }
    }

    public void Dispose()
    {
        cancellationTokenSource.Cancel();
        cancellationTokenSource.Dispose();
    }
}
