@page "/"

<PageTitle>Dashboard</PageTitle>

<div class="d-flex align-items-start justify-content-between gap-3 mb-4">
    <div>
        <h1>Dashboard</h1>
        <p class="text-muted mb-0">Your daily sales overview will appear here.</p>
    </div>
    <span class="badge text-bg-secondary">Planned</span>
</div>

<div class="row g-3">
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted">Today's sales</div>
                <div class="fs-3 fw-semibold">—</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted">Transactions</div>
                <div class="fs-3 fw-semibold">—</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted">Low-stock items</div>
                <div class="fs-3 fw-semibold">—</div>
            </div>
        </div>
    </div>
</div>
